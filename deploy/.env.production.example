# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# 
# CRITICAL: This file contains examples only! 
# 
# 1. Copy this file to `.env` in your application root
# 2. Replace ALL placeholder values with your real production credentials
# 3. NEVER commit the real `.env` file to version control
# 4. Keep `.env` file permissions secure (chmod 600 on Linux)
#
# =============================================================================

# -----------------------------------------------------------------------------
# Django Core Settings
# -----------------------------------------------------------------------------

# REQUIRED: Generate a new secret key for production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Or use: https://djecrety.ir/
DJANGO_SECRET_KEY=CHANGE-ME-TO-A-REAL-SECRET-KEY-50-PLUS-CHARACTERS-LONG

# REQUIRED: Set to False in production (NEVER use True in production!)
DJANGO_DEBUG=False

# REQUIRED: Your production domain(s), comma-separated
# Example: yourdomain.com,www.yourdomain.com,api.yourdomain.com
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# REQUIRED: Base URL for building absolute URLs (no trailing slash)
# Used for generating links in emails, API responses, etc.
PUBLIC_BASE_URL=https://yourdomain.com

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------

# REQUIRED: Production MySQL database connection
# Format: mysql://username:password@host:port/database_name
# 
# Example with cPanel:
# DATABASE_URL=mysql://cpanel_user:strong_password@localhost:3306/cpanel_dbname
#
# Example with remote MySQL:
# DATABASE_URL=mysql://user:password@mysql.example.com:3306/dbname
#
# IMPORTANT: Use strong password, no special shell characters without URL encoding
DATABASE_URL=mysql://your_mysql_user:your_mysql_password@localhost:3306/your_database_name

# Optional: Database connection pool timeout (seconds)
# Default: 600 (10 minutes) - keeps connections alive for reuse
DB_CONN_MAX_AGE=600

# -----------------------------------------------------------------------------
# Cloudinary Configuration (Media Storage)
# -----------------------------------------------------------------------------

# REQUIRED: Cloudinary credentials for media file storage
# Get these from: https://console.cloudinary.com/
# Dashboard → Account Details
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Optional: Cloudinary token authentication (for advanced media security)
# Only needed if you have the Token-Based Authentication add-on
# CLOUDINARY_AUTH_TOKEN_KEY=your-auth-token-key

# -----------------------------------------------------------------------------
# CORS Configuration (Frontend Access)
# -----------------------------------------------------------------------------

# REQUIRED: Allowed origins for CORS (your frontend domain)
# Format: https://domain.com (must include protocol, no trailing slash)
# Comma-separated for multiple domains
# 
# Example for production:
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
#
# Example for staging + production:
# CORS_ALLOWED_ORIGINS=https://staging.yourdomain.com,https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# -----------------------------------------------------------------------------
# Clerk Authentication (Optional)
# -----------------------------------------------------------------------------

# If using Clerk for user authentication, provide production credentials
# Get these from: https://dashboard.clerk.com/
# 
# IMPORTANT: Use PRODUCTION keys, not development keys!

# Clerk JWT issuer URL (from Clerk dashboard → API Keys)
CLERK_ISSUER=https://your-app.clerk.accounts.dev

# Clerk secret key (starts with sk_live_ for production)
CLERK_SECRET_KEY=sk_live_your_production_secret_key

# Optional: JWKS URL (auto-generated from issuer if not set)
# CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json

# -----------------------------------------------------------------------------
# Security Settings
# -----------------------------------------------------------------------------

# SSL/TLS enforcement - set to True once SSL certificate is active
# WARNING: Setting to True before SSL is active will break your site!
# Default: True (recommended for production)
SECURE_SSL_REDIRECT=True

# HTTP Strict Transport Security (HSTS) duration in seconds
# Default: 31536000 (1 year)
# Set to 0 to disable HSTS (only during initial SSL setup)
SECURE_HSTS_SECONDS=31536000

# Include subdomains in HSTS policy
# Default: True
SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# HSTS preload (optional, requires domain registration)
# Only enable if you plan to submit to https://hstspreload.org/
# Default: False
SECURE_HSTS_PRELOAD=False

# Trust proxy SSL headers (required for cPanel/Apache)
# Default: True (cPanel uses reverse proxy)
TRUST_PROXY_SSL_HEADER=True

# -----------------------------------------------------------------------------
# File Upload Limits
# -----------------------------------------------------------------------------

# Maximum upload file size in MB
# Default: 8
# Adjust based on your needs (payment screenshots, service images)
MAX_UPLOAD_MB=8

# Maximum image dimensions (pixels) - protection against decompression bombs
# Default: 50000000 (50 megapixels)
MAX_UPLOAD_PIXELS=50000000

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------

# Django log level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Recommended for production: INFO or WARNING
DJANGO_LOG_LEVEL=INFO

# Database query logging level
# Options: DEBUG (logs all queries), INFO, WARNING, ERROR
# Recommended for production: INFO (only log slow queries)
DJANGO_SQL_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Private Media Storage
# -----------------------------------------------------------------------------

# Optional: Custom path for private media files (payment screenshots)
# Default: {BASE_DIR}/private-media
# 
# IMPORTANT: This folder should be OUTSIDE your web root for security
# Example: /home/username/private-media (NOT in public_html)
# PRIVATE_MEDIA_ROOT=/home/username/salon-backend/private-media

# -----------------------------------------------------------------------------
# Performance & Rate Limiting
# -----------------------------------------------------------------------------

# API rate limits are defined in Django settings, but you can adjust if needed
# Default throttle rates:
# - Booking submissions: 10/hour
# - General submissions: 20/hour
# - Read endpoints: unlimited

# -----------------------------------------------------------------------------
# Example Complete Configuration
# -----------------------------------------------------------------------------
#
# DJANGO_SECRET_KEY=xJ8Vn2Kp9Lm4Qw7Rt6Yz3Xu5Cv1Bn0Mp8Hg4Jf2Dk9As6Zq3Wl7
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=salon.example.com,www.salon.example.com
# PUBLIC_BASE_URL=https://salon.example.com
#
# DATABASE_URL=mysql://salon_user:StrongPass123!@localhost:3306/salon_prod
# DB_CONN_MAX_AGE=600
#
# CLOUDINARY_CLOUD_NAME=my-salon-cloud
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz123456
#
# CORS_ALLOWED_ORIGINS=https://salon.example.com,https://www.salon.example.com
#
# CLERK_ISSUER=https://salon-prod.clerk.accounts.dev
# CLERK_SECRET_KEY=sk_live_abcdefghijk1234567890
#
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
#
# DJANGO_LOG_LEVEL=INFO
# DJANGO_SQL_LOG_LEVEL=WARNING
#
# -----------------------------------------------------------------------------

# =============================================================================
# DEPLOYMENT CHECKLIST
# =============================================================================
#
# Before going live, ensure:
# 
# ✅ All CHANGE-ME and your-xxx placeholders are replaced with real values
# ✅ DJANGO_SECRET_KEY is unique and never used elsewhere
# ✅ DJANGO_DEBUG is set to False
# ✅ DJANGO_ALLOWED_HOSTS includes your actual domain
# ✅ DATABASE_URL points to your production MySQL database
# ✅ Cloudinary credentials are from your production account
# ✅ CORS_ALLOWED_ORIGINS includes your frontend domain with https://
# ✅ Clerk credentials are production keys (sk_live_xxx)
# ✅ SSL certificate is active before enabling SECURE_SSL_REDIRECT
# ✅ File permissions are secure (chmod 600 .env on Linux)
# ✅ .env file is in .gitignore and never committed
# ✅ Run: python manage.py check --deploy
#
# =============================================================================

# -----------------------------------------------------------------------------
# EMAIL — REQUIRED, and the most commonly missed block
# -----------------------------------------------------------------------------
# Without this the site still takes bookings and still stores them, and the
# salon is never told about any of them. Nothing errors; the notification
# simply is not sent. That is the failure this block exists to prevent.
#
# There are TWO places these can be set and the admin wins:
#
#     Admin -> Site -> Email / SMTP settings
#
# is where the salon owner sets the Gmail address and App Password, stored
# encrypted. What is below is the fallback a fresh deploy runs on until that
# screen is filled in. Setting it here as well is belt and braces.
#
# Gmail needs an App Password, not the account password:
#   1. myaccount.google.com -> Security -> turn on 2-Step Verification
#   2. myaccount.google.com/apppasswords -> create one -> paste the 16 chars
#
# Verify after deploying, before announcing the site:
#   python manage.py send_test_email you@example.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=yoursalon@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password

# Blank uses EMAIL_HOST_USER. Gmail rewrites the sender to the authenticated
# account anyway unless the address is a verified alias, so a display name is
# the only part worth setting: "Salon Kathmandu <yoursalon@gmail.com>".
DEFAULT_FROM_EMAIL=

# Where Django sends its own error mail. Same address is fine.
SERVER_EMAIL=

# Who gets told about a new booking or enquiry. Comma-separated.
# Blank falls back to EMAIL_HOST_USER.
SALON_NOTIFY_EMAILS=

# Seconds before a stuck SMTP connection is abandoned. Sends happen inside the
# web request, so this is a request being held open — keep it short.
EMAIL_TIMEOUT=10

# Notifications go out on a background thread so a customer's booking never
# waits on Gmail. Set False only to debug a delivery problem.
EMAIL_NOTIFY_ASYNC=True

# Derived from EMAIL_PORT (587 = TLS, 465 = SSL). Only set these for a
# non-Gmail host that disagrees.
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False

# Only to silence mail entirely, e.g. on a staging copy that must never email
# real customers:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# -----------------------------------------------------------------------------
# LOGGING TO DISK
# -----------------------------------------------------------------------------
# With DEBUG=False the app also writes WARNING and above to a rotating file
# (5MB x 5). Under Passenger, stdout goes somewhere cPanel may rotate or not
# surface at all, and a booking that failed on Saturday night needs to still be
# findable on Monday.
#
# Default is backend/logs/. Point this OUTSIDE public_html — a log of 500s is
# not something to serve to the public. If the directory cannot be written the
# app still boots and simply logs to stdout only.
DJANGO_LOG_DIR=/home/youraccount/salon-logs

# -----------------------------------------------------------------------------
# CLERK — the value the template above misses
# -----------------------------------------------------------------------------
# Which frontend origins may present a token. Without it a token minted for
# somebody else's Clerk app is accepted. Comma-separated, no trailing slash.
CLERK_AUTHORIZED_PARTIES=https://yourdomain.com,https://www.yourdomain.com

# -----------------------------------------------------------------------------
# OPTIONAL — only if the host provides it
# -----------------------------------------------------------------------------
# Shared cache across workers. Without it each Passenger worker keeps its own
# copy of the content cache, which costs a little duplicated work and is
# otherwise fine. Most cPanel plans have no Redis; leaving this blank is normal.
REDIS_URL=

# Cloudinary's token-auth add-on. Payment screenshots are already refused
# without a signature; this additionally makes a copied link expire. Only set
# it if the Cloudinary plan includes the add-on.
CLOUDINARY_AUTH_TOKEN_KEY=

# Where payment screenshots land when Cloudinary is NOT configured. Must be
# outside public_html — these are financial records showing a customer's name
# and an eSewa transfer.
PRIVATE_MEDIA_ROOT=/home/youraccount/salon-private-media
