# Copy to .env and edit. .env is gitignored; this file is the template.

# Generate a fresh one for anything deployed:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database --------------------------------------------------------------
# Leave blank for SQLite, which is what development uses. Production must set
# this: every booking is a write and SQLite locks the whole database for each
# one, so DJANGO_DEBUG=False on SQLite is refused at startup.
#
# PostgreSQL (recommended for production):
#   postgres://user:password@host:5432/dbname
# MySQL (supported):
#   mysql://user:password@host:3306/dbname
DATABASE_URL=
DB_CONN_MAX_AGE=600

# --- Uploads ---------------------------------------------------------------
# The booking endpoint accepts a file from anyone with no account, so both of
# these are load-bearing rather than tidiness.
MAX_UPLOAD_MB=8
MAX_UPLOAD_PIXELS=50000000
# Where payment screenshots are stored. Must NOT be inside media/ — anything
# there is served to whoever guesses the path, and these are financial records.
PRIVATE_MEDIA_ROOT=

# --- Logging ---------------------------------------------------------------
# Everything goes to stdout. DJANGO_SQL_LOG_LEVEL=DEBUG echoes every query,
# which is occasionally useful and always overwhelming.
DJANGO_LOG_LEVEL=
DJANGO_SQL_LOG_LEVEL=INFO

# --- HTTPS (production only; ignored while DJANGO_DEBUG=True) --------------
# Turn the first two off for the first deploy of a new domain if it is briefly
# served over plain HTTP. HSTS is not something a browser lets you take back.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
TRUST_PROXY_SSL_HEADER=True

# Origins allowed to call the API from a browser. The Next.js dev server is 3000.
#
# In production this must list the real frontend origin, and it must agree with
# the frontend's own SALON_SITE_URL -- the booking form and the contact form
# post here from the browser, so a mismatch means every submission is refused by
# CORS while the pages themselves look fine. Never "*": CSRF_TRUSTED_ORIGINS is
# derived from the https entries in this list.
#
#   production example:
#   CORS_ALLOWED_ORIGINS=https://your-real-domain.com,https://www.your-real-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Absolute base used to build image URLs in API responses when a request
# context is not available (e.g. management commands). Leave blank to let the
# incoming request decide, which is what you want in development.
PUBLIC_BASE_URL=

# --- Cloudinary ------------------------------------------------------------
# Where admin uploads are stored. Copy all three from the Cloudinary dashboard
# (Settings -> API Keys); the cloud name is also the "yourname" in
# res.cloudinary.com/yourname/... Leave any of them blank and uploads fall back
# to the local media/ folder, which is what a fresh clone does.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional, and needs Cloudinary's token-based authentication add-on. Makes the
# signed URLs for payment screenshots expire. Without it they are still signed
# and still refused unsigned; they just do not time out.
CLOUDINARY_AUTH_TOKEN_KEY=

# --- Accounts (Clerk) ------------------------------------------------------
# Optional, and separate from the frontend keys. Set this to the Clerk issuer
# shown in the dashboard (Configure -> API Keys -> "Frontend API URL"), so the
# backend can verify session tokens against Clerk's published signing keys and
# record WHICH account made each booking. Unset = bookings stay anonymous.
CLERK_ISSUER=https://your-app.clerk.accounts.dev

# Optional, and worth setting in production. Comma-separated list of origins
# allowed to have minted a session token this API will accept, checked against
# the token's `azp` claim. It is what stops a Clerk token issued for a different
# site being replayed against this one.
#
# Leave blank and the check does not run, which is the default and keeps an
# existing deployment working unchanged. Set it to the same origin(s) as
# CORS_ALLOWED_ORIGINS above.
#
#   production example:
#   CLERK_AUTHORIZED_PARTIES=https://your-real-domain.com
CLERK_AUTHORIZED_PARTIES=
