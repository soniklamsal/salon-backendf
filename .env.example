# Copy to .env and edit. .env is gitignored; this file is the template.

# Generate a fresh one for anything deployed:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database --------------------------------------------------------------
# Leave blank for SQLite, which is what development uses. Production must set
# this: every booking is a write and SQLite locks the whole database for each
# one, so DJANGO_DEBUG=False on SQLite is refused at startup.
#
# PostgreSQL (recommended for production):
#   postgres://user:password@host:5432/dbname
# MySQL (supported):
#   mysql://user:password@host:3306/dbname
DATABASE_URL=
DB_CONN_MAX_AGE=600

# --- Uploads ---------------------------------------------------------------
# The booking endpoint accepts a file from anyone with no account, so both of
# these are load-bearing rather than tidiness.
MAX_UPLOAD_MB=8
MAX_UPLOAD_PIXELS=50000000
# Where payment screenshots are stored. Must NOT be inside media/ — anything
# there is served to whoever guesses the path, and these are financial records.
PRIVATE_MEDIA_ROOT=

# --- Logging ---------------------------------------------------------------
# Everything goes to stdout. DJANGO_SQL_LOG_LEVEL=DEBUG echoes every query,
# which is occasionally useful and always overwhelming.
DJANGO_LOG_LEVEL=
DJANGO_SQL_LOG_LEVEL=INFO

# --- HTTPS (production only; ignored while DJANGO_DEBUG=True) --------------
# Turn the first two off for the first deploy of a new domain if it is briefly
# served over plain HTTP. HSTS is not something a browser lets you take back.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
TRUST_PROXY_SSL_HEADER=True

# Origins allowed to call the API from a browser. The Next.js dev server is 3000.
#
# In production this must list the real frontend origin, and it must agree with
# the frontend's own SALON_SITE_URL -- the booking form and the contact form
# post here from the browser, so a mismatch means every submission is refused by
# CORS while the pages themselves look fine. Never "*": CSRF_TRUSTED_ORIGINS is
# derived from the https entries in this list.
#
#   production example:
#   CORS_ALLOWED_ORIGINS=https://your-real-domain.com,https://www.your-real-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Absolute base used to build image URLs in API responses when a request
# context is not available (e.g. management commands). Leave blank to let the
# incoming request decide, which is what you want in development.
PUBLIC_BASE_URL=

# --- Cloudinary ------------------------------------------------------------
# Where admin uploads are stored. Copy all three from the Cloudinary dashboard
# (Settings -> API Keys); the cloud name is also the "yourname" in
# res.cloudinary.com/yourname/... Leave any of them blank and uploads fall back
# to the local media/ folder, which is what a fresh clone does.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional, and needs Cloudinary's token-based authentication add-on. Makes the
# signed URLs for payment screenshots expire. Without it they are still signed
# and still refused unsigned; they just do not time out.
CLOUDINARY_AUTH_TOKEN_KEY=

# --- Accounts (Google sign-in) ---------------------------------------------
# Optional. The frontend verifies Google at sign-in, then mints a short-lived
# token per API call and sends it as `Authorization: Bearer ...`. This is the
# secret it signs with and this API verifies with, so it must be identical to
# SALON_AUTH_SECRET in salon-frontend/.env.local -- character for character.
#
# Unset = verification is off and bookings stay anonymous, which is what keeps
# the site working before it is configured. Set to different values on the two
# sides and you get the confusing case: people can sign in, and none of their
# bookings are attributed to them.
#
# Generate with:  openssl rand -base64 32
SALON_AUTH_SECRET=

# Recorded so the admin can tell which Google project the accounts belong to.
# Nothing is verified against it here -- Google is verified on the frontend.
GOOGLE_CLIENT_ID=

# Who may mint tokens, and who they are for: checked as the `iss` and `aud`
# claims. The defaults match what the frontend sends, so leave them unless you
# change both sides together.
# SALON_AUTH_ISSUER=salon-frontend
# SALON_AUTH_AUDIENCE=salon-api

# --- Email (SMTP / Gmail) --------------------------------------------------
# These are the FALLBACK. The admin screen wins:
#
#     Admin -> Core -> Email / SMTP settings
#
# It is the place to set this up -- no file, no restart -- and it is where the
# Gmail App Password belongs, stored encrypted. What is below is what a fresh
# clone, CI and the test suite run on, and what applies until that screen is
# filled in and switched on.
# Leave the user and password blank and nothing is sent: mail is printed to the
# console instead, which is what development wants. Fill both in and the same
# code sends for real. Verify either way with:
#
#   python manage.py send_test_email you@example.com
#
# For Gmail the password below is NOT the account password -- Google refuses
# those over SMTP. It is a 16-character App Password, and getting one needs
# 2-Step Verification switched on first:
#
#   1. myaccount.google.com -> Security -> turn on 2-Step Verification
#   2. myaccount.google.com/apppasswords -> name it "Salon backend" -> Create
#   3. paste the 16 characters below (the spaces Google shows are ignored)
#
# A Google Workspace account may have App Passwords blocked by its admin; a
# free @gmail.com account only needs the two steps above. Gmail also caps
# sending at ~500 messages a day, which is ample here but is a real ceiling.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Derived from the port (587 = TLS, 465 = SSL), so both are normally left
# alone. Only set them for a non-Gmail host that disagrees.
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# Seconds before a stuck SMTP connection is abandoned. Sends happen inside web
# requests, so this is a request that is being held open.
EMAIL_TIMEOUT=10

# What recipients see in the From line. Blank uses EMAIL_HOST_USER, which is
# what Gmail enforces anyway -- it rewrites the sender to the authenticated
# account unless the address is a verified alias under "Send mail as".
# A display name is allowed: DEFAULT_FROM_EMAIL=Salon <salon@gmail.com>
DEFAULT_FROM_EMAIL=

# Notifications send on a background thread so a customer's booking is never
# waiting on Gmail. Set False to send inline when debugging a delivery problem.
EMAIL_NOTIFY_ASYNC=True

# The salon's own inbox: who gets notified about a new booking or enquiry.
# Comma-separated. Blank means the sending account above.
SALON_NOTIFY_EMAILS=

